set shell := ["bash", "-c"]

# Regenerate the derived files (repos/*.tfvars) from the plugin records in
# plugins/. Run after editing plugins/*.json or *.description.md.
gen:
    @uv run scripts/generate.py

# Fail when the tofu inputs are stale; used in CI to enforce `just gen` freshness.
check-generated:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p /tmp/gen-before
    rm -rf /tmp/gen-before/repos
    cp -a repos /tmp/gen-before/repos
    just gen > /dev/null
    if ! diff -r /tmp/gen-before/repos repos > /dev/null; then
        echo "Generated files are stale. Run 'just gen' and commit the result." >&2
        exit 1
    fi
    echo "Generated files are up to date."

# Plan changes for a specific snap (tfvars files are keyed by snap name)
plan repo:
    @tofu init
    @tofu plan -var="snap_name={{ repo }}" -var-file="profiles/manifest.tfvars" -var-file="repos/{{ repo }}.tfvars"

# Apply changes for a specific snap
apply repo:
    @tofu init
    @tofu apply -auto-approve -var="snap_name={{ repo }}" -var-file="profiles/manifest.tfvars" -var-file="repos/{{ repo }}.tfvars"

# (plan/apply recipes below read repos/*.tfvars generated by `just gen`)

# Plan all repos (each in isolation)
plan-all:
    #!/usr/bin/env bash
    export TF_PLUGIN_CACHE_DIR="/tmp/tofu-plugin-cache"
    mkdir -p "$TF_PLUGIN_CACHE_DIR"
    for file in repos/*.tfvars; do
        repo=$(basename "$file" .tfvars)
        export TF_DATA_DIR="/tmp/tofu-$repo"
        tofu init 2>&1
        tofu plan -no-color -state="/tmp/tofu-state-$repo.tfstate" -var="snap_name=$repo" -var-file="profiles/manifest.tfvars" -var-file="repos/$repo.tfvars" 2>&1 || true
    done

# Sync all repositories (each in isolation)
sync-all:
    #!/usr/bin/env bash
    export TF_PLUGIN_CACHE_DIR="/tmp/tofu-plugin-cache"
    mkdir -p "$TF_PLUGIN_CACHE_DIR"
    for file in repos/*.tfvars; do
        repo=$(basename "$file" .tfvars)
        export TF_DATA_DIR="/tmp/tofu-$repo"
        tofu init 2>&1
        tofu apply -auto-approve -no-color -state="/tmp/tofu-state-$repo.tfstate" -var="snap_name=$repo" -var-file="profiles/manifest.tfvars" -var-file="repos/$repo.tfvars" 2>&1
    done
